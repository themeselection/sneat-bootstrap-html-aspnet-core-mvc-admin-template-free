@{
  TempData.Keep();
  string? currentPage = ViewContext.HttpContext.Request.Path;
}

<aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">

  @* ! Hide app brand if navbar-full *@
  <div
    class='app-brand demo @((@ViewData["navbarFull"] != null && Convert.ToBoolean(@ViewData["navbarFull"])) ? "d-xl-none" : "")'>
    <a asp-controller="Dashboards" asp-action="Live" class="app-brand-link">
      <span class="app-brand-logo demo">
        @await Html.PartialAsync("../_Partials/_Macros")
      </span>
      <span class="app-brand-text demo menu-text fw-bold ms-2">@TempData.Peek("appName")</span>
    </a>

    <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto">
      <i class="icon-base bx bx-chevron-left d-block d-xl-none align-middle"></i>
    </a>
  </div>

  <div class="menu-divider mt-0"></div>

  <div class="menu-inner-shadow"></div>

  @* ! Full version menu-items *@
  <ul class="menu-inner py-1">
    <!-- DASHBOARD -->
    <li class='menu-item@(currentPage.EndsWith("/") || currentPage.StartsWith("/Dashboard") ? " active open" : "")'>
      <a href="javascript:void(0);" class="menu-link menu-toggle">
        <i class="menu-icon icon-base bx bx-home-smile"></i>
        <div class="text-truncate">
          Dashboard
        </div>
      </a>

      <ul class="menu-sub">
        <li class='menu-item@(currentPage == "/Dashboards/Live" ? " active" : "")'>
          <a asp-controller="Dashboards" asp-action="Live" class="menu-link">
            <div class="text-truncate">
              Live Metrics
            </div>
          </a>
        </li>
      </ul>
    </li>

    <!-- OPERATIONS -->
    <li class='menu-item@(currentPage.StartsWith("/Upload") ? " active open" : "")'>
      <a href="javascript:void(0);" class="menu-link menu-toggle">
        <i class="menu-icon icon-base bx bx-upload"></i>
        <div class="text-truncate">
          Operations
        </div>
      </a>

      <ul class="menu-sub">
        <li class='menu-item@(currentPage == "/Upload/Orders" ? " active" : "")'>
          <a asp-controller="Upload" asp-action="Orders" class="menu-link">
            <div class="text-truncate">
              Upload Orders
            </div>
          </a>
        </li>
      </ul>
    </li>

    <!-- LIVE CONFIG -->
    <li class='menu-item@(currentPage.StartsWith("/LiveConfigs") ? " active open" : "")'>
      <a href="javascript:void(0);" class="menu-link menu-toggle">
        <i class="menu-icon icon-base bx bx-cog"></i>
        <div class="text-truncate">
          Live Configs
        </div>
      </a>

      <ul class="menu-sub">
        <li class='menu-item@(currentPage == "/LiveConfigs" ? " active" : "")'>
          <a asp-controller="LiveConfigs" asp-action="Index" class="menu-link">
            <div class="text-truncate">
              Manage Lives
            </div>
          </a>
        </li>
        <li class='menu-item@(currentPage == "/LiveConfigs/Create" ? " active" : "")'>
          <a asp-controller="LiveConfigs" asp-action="Create" class="menu-link">
            <div class="text-truncate">
              Create Live
            </div>
          </a>
        </li>
      </ul>
    </li>

    <!-- REPORTS -->
    <li class='menu-item@(currentPage.StartsWith("/Reports") ? " active open" : "")'>
      <a href="javascript:void(0);" class="menu-link menu-toggle">
        <i class="menu-icon icon-base bx bx-bar-chart-alt-2"></i>
        <div class="text-truncate">
          Reports
        </div>
      </a>
      <ul class="menu-sub">
        <li class='menu-item@(currentPage == "/Reports/Logs" ? " active" : "")'>
          <a asp-controller="Reports" asp-action="Logs" class="menu-link">
            <div class="text-truncate">
              Report Logs
            </div>
          </a>
        </li>
      </ul>
    </li>
  </ul>

</aside>
