@model IEnumerable<AspnetCoreMvcFull.Models.ReportLog>

@{
  ViewData["Title"] = "Report Logs";
}

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <div>
      <h5 class="mb-0">Report Logs</h5>
      <small class="text-muted">
        Lịch sử report và trạng thái xử lý hệ thống
      </small>
    </div>
  </div>
  <div class="table-responsive text-nowrap">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
      <tr>
        <th>Time</th>
        <th>Live Config ID</th>
        <th>Status</th>
        <th>Error Message</th>
      </tr>
      </thead>
      <tbody class="table-border-bottom-0">
      @foreach (var item in Model)
      {
        <tr>
          <td>
            <span class="fw-semibold">
              @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
            </span>
          </td>
          <td>
            <span class="badge bg-label-secondary">
              #@item.LiveConfigId
            </span>
          </td>
          <td>
            @if (item.IsSuccess)
            {
              <span class="badge bg-label-success">
                <i class="bx bx-check-circle me-1"></i>
                Success
              </span>
            }
            else
            {
              <span class="badge bg-label-danger">
                <i class="bx bx-x-circle me-1"></i>
                Failed
              </span>
            }
          </td>
          <td>
            @if (string.IsNullOrEmpty(item.ErrorMessage))
            {
              <span class="text-muted">
                No Error
              </span>
            }
            else
            {
              <span class="text-danger">
                @item.ErrorMessage
              </span>
            }
          </td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>
